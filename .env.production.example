# ============================================================
# SOS Guardian — Production Environment Configuration
# ============================================================

# Environment Mode (Enforces secure cookies and production defaults)
FLASK_ENV=production

# Strong Cryptographic Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=CHANGE_THIS_TO_A_COMPLEX_RANDOM_SECRET_KEY_HEX

# Enforce Secure HTTPS-Only Session Cookies (Requires HTTPS in production)
SESSION_COOKIE_SECURE=true

# Persistent Database File Path (For Docker, Render Disks, or VPS Volumes)
DATABASE_PATH=data/sos_guardian.db

# Server Bind Settings
HOST=0.0.0.0
PORT=5000
WAITRESS_THREADS=4

# Reverse Proxy Header Depth (Set to 1 if behind Render, Nginx, or AWS ALB)
PROXY_FIX_FOR=1
PROXY_FIX_PROTO=1
PROXY_FIX_HOST=1
PROXY_FIX_PREFIX=1

# Static Asset Cache Lifetime (Seconds; default 86400 = 24 hours)
STATIC_CACHE_SECONDS=86400

# ------------------------------------------------------------
# SMS NOTIFICATIONS PROVIDER
# ------------------------------------------------------------
# Options: "httpsms", "fast2sms", "twilio", or "mock"
SMS_PROVIDER=httpsms

# httpSMS Android Phone Gateway (Zero-cost cellular SMS via Android app)
HTTPSMS_API_KEY=
HTTPSMS_FROM_NUMBER=

# Fast2SMS Quick Route API Key (For live Indian mobile SMS alerts)
FAST2SMS_API_KEY=

# Twilio Credentials (If SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------
# TELEGRAM BOT INTEGRATION (OPTIONAL)
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
