# ============================================================
# SOS Guardian - Environment Variables Configuration
# ============================================================

# Flask Session Secret Key
FLASK_SECRET_KEY=SOS_GUARDIAN_CHANGE_THIS_SECRET_KEY

# ------------------------------------------------------------
# SMS NOTIFICATIONS
# ------------------------------------------------------------
# Default is "mock" (safe console simulation, preserves free credits).
# To enable zero-cost live SMS to Indian mobile phones:
# 1. Sign up for free at https://www.fast2sms.com/
# 2. Copy your API Key from Dev API section
# 3. Set SMS_PROVIDER=fast2sms
# 4. Set FAST2SMS_API_KEY=your_key_here
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=5sb9PKtWadhQjXypYcSDwMf2N73vZ0Ho8JmuzRqGxFkUVBTA4Ozbyt4E2mH59cuIwAsMn8TpZD0Krjvx

# Optional Twilio Configuration (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------
# TELEGRAM BOT NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------
# 1. Message @BotFather on Telegram to create a bot and get an API token.
# 2. Paste the bot token below.
# 3. Recipients must start your bot (/start) and provide their Telegram username or Chat ID.
TELEGRAM_BOT_TOKEN=9077012068:AAG1f70sDjfJijH5ri3J8RZMzdSdyMueM4w

# ------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (OPTIONAL)
# ------------------------------------------------------------
FCM_SERVER_KEY=
