# ============================================================
# SOS Guardian - Environment Variables Configuration
# ============================================================

# Flask Session Secret Key
FLASK_SECRET_KEY=SOS_GUARDIAN_CHANGE_THIS_SECRET_KEY

# ------------------------------------------------------------
# SMS NOTIFICATIONS
# ------------------------------------------------------------
# Options: "httpsms", "fast2sms", "twilio", or "mock"
# Default is "mock" (safe console simulation, preserves free credits).
# To enable zero-cost live SMS directly via your Android phone gateway:
# 1. Sign up at https://httpsms.com/ and install the httpSMS app on your Android phone
# 2. Copy your API Key from the httpSMS dashboard
# 3. Set SMS_PROVIDER=httpsms
# 4. Set HTTPSMS_API_KEY=your_api_key_here
# 5. Set HTTPSMS_FROM_NUMBER=+91XXXXXXXXXX (your Android SIM phone number in E.164)
SMS_PROVIDER=mock
HTTPSMS_API_KEY=your_httpsms_api_key_here
HTTPSMS_FROM_NUMBER=+91XXXXXXXXXX

# Fast2SMS Configuration (if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# Optional Twilio Configuration (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------
# TELEGRAM BOT NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------
# 1. Message @BotFather on Telegram to create a bot and get an API token.
# 2. Paste the bot token below.
# 3. Recipients must start your bot (/start) and provide their Telegram username or Chat ID.
TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (OPTIONAL)
# ------------------------------------------------------------
FCM_SERVER_KEY=
