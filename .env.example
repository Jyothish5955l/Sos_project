# ============================================================
# SOS Guardian - Environment Variables Configuration
# ============================================================

# Flask Session Secret Key
FLASK_SECRET_KEY=SOS_GUARDIAN_CHANGE_THIS_SECRET_KEY

# ------------------------------------------------------------
# TELEGRAM BOT NOTIFICATIONS
# ------------------------------------------------------------
# 1. Message @BotFather on Telegram to create a bot and get an API token.
# 2. Paste the bot token below.
# 3. Recipients must start your bot (/start) and provide their Telegram username or Chat ID.
TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------
# SMS NOTIFICATIONS
# ------------------------------------------------------------
# Provider options: "mock" (default, free console simulation), "twilio", or "fast2sms"
SMS_PROVIDER=mock

# Twilio Configuration (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Fast2SMS Configuration (if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# ------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS)
# ------------------------------------------------------------
FCM_SERVER_KEY=
